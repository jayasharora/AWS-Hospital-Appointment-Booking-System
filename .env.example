# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=medicare-cloud-secret-key-change-in-prod-2026
PORT=5000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite for local dev)
# For local SQLite: sqlite:///medicare.db
# For PostgreSQL / AWS RDS: postgresql://medicare_admin:SecurePassword123!@medicare-rds.c123456789.us-east-1.rds.amazonaws.com:5432/medicaredb
DATABASE_URL=sqlite:///medicare.db

# AWS CloudWatch Configuration
AWS_REGION=us-east-1
ENABLE_CLOUDWATCH=false
CLOUDWATCH_NAMESPACE=MediCare/HospitalApp
CLOUDWATCH_LOG_GROUP=/medicare/application-logs
# When running on EC2 with IAM Role attached, leave access keys empty:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Auto Recovery Configuration (Fault Tolerance Simulation)
AUTO_RECOVERY_ENABLED=true
AUTO_RECOVERY_DELAY_SECONDS=12
CPU_SIMULATION_MAX_SECONDS=15
